# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Ignore compiled files
*.class
*.o
*.pyc

# Ignore temporary files
*~

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Ignore build output
/dist/

# Ignore environment-specific files
.env

# Ignore editor-specific files
.vscode/

# Ignore logs
logs/

# Ignore all .py files
*.py

/frontend/buddease/src/app/components/documents/privateDocs

# ============= BACKUP & REPORT FILES =============
# Backup patterns
*.backup.*
*.backup-*
*.bak
*.missing-comment-backup.*
backup-*
~*

# Backup directories
.smart-backups/
.migration-backups/
.migration-reports/
.comment-fix-backups/
.type-import-backups/
.import-fix-backups/
.permanent-safe-points/

# Reports
reports/
*.report.*
*.summary.*
*-import-fixes-*.md
*-import-summary-*.txt
*-type-import-fixes-*.md

# Test files
test-*
test-headers/
