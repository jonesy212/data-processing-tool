# Script backup files
scripts/**/*.backup.*

# Add backup patterns to .gitignore if not already there
if ! grep -q "*.backup.*" .gitignore; then
  echo "" >> .gitignore
  echo "# Backup files (generated by migration/safety systems)" >> .gitignore
  echo "*.backup.*" >> .gitignore
  echo "*.backup-*" >> .gitignore
  echo "*.bak" >> .gitignore
  echo ".migration-backups/" >> .gitignore
  echo ".smart-backups/" >> .gitignore
  echo ".permanent-safe-points/" >> .gitignore
  echo ".missing-comment-backup/" >> .gitignore
fi