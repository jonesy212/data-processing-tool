{
  "backupOnChange": true,
  "backupOnlyFixed": false,
  "createProductionBackup": true,
  "trackEntityChanges": true,
  "cleanupOldBackups": true,
  "backupDir": ".smart-backups",
  "maxBackups": 20,
  
  "useDifferentialBackups": true,
  "storeDiffs": true,
  "maxDiffChain": 10,
  "compressDiffs": true,
  "diffAlgorithm": "text",
  "autoConsolidate": true,
  "consolidateAfter": 50, 
  
  "excludePatterns": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules/**"
  ]
}