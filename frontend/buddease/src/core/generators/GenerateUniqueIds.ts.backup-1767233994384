const USER_ID_PREFIX = "user_id";
export function generateUserID(userName: string) {
  const generatedID = UniqueIDGenerator.generateID(
    USER_ID_PREFIX,
    userName,
    NotificationTypeEnum.GENERATED_ID
  );
  return {
    [Symbol.iterator]: function* () {
      yield generatedID;
    },
  };
}

