function convertSnapshotMethods<
  T extends BaseDataEntity = BaseDataRoot,
  K extends T = T,
  Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
  AttachmentType extends Attachment = Attachment,
  ExcludedFields extends keyof T = DefaultExcludedFields<T>,
  IncludedFields extends keyof T = keyof T
>(
  snapshotMethods: 
    | SnapshotStoreMethods<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields> 
    | SnapshotMethodFunction<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[]
    | undefined,
  snapshot: Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
  snapshotId: string,
  snapshotData: SnapshotData<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
  snapshotConfig: SnapshotStoreConfig<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
  callback: (snapshotStore: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>) => Promise<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>>,
  versionHistory: VersionHistory<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>
): Promise<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>> {
  return new Promise(async (resolve, reject) => {
    try {
      if (!snapshotMethods) {
        throw new Error("No snapshot methods provided");
      }

      // Check if snapshotMethods is an array (array of functions)
      if (Array.isArray(snapshotMethods)) {
        // Handle array of callable functions
        for (const method of snapshotMethods) {
          // Use type guard to verify it's a callable function
          if (typeof method !== 'function') {
            throw new Error("Array contains non-function items. All items must be callable functions.");
          }
          
          const result = await method(snapshot, snapshotId, snapshotData, snapshotConfig, callback, versionHistory);
          snapshot = result; // Chain the results
        }
      } else {
        // Use type guard to check if it's a SnapshotStoreMethods object
        if (isSnapshotStoreMethods<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>(snapshotMethods)) {
          // Handle SnapshotStoreMethods object
          const snapshotStoreMethods = snapshotMethods;
          
          // Option 1: Call specific methods (like createSnapshot)
          if (snapshotStoreMethods.createSnapshot) {
            const { snapshot: updatedSnapshot } = await snapshotStoreMethods.createSnapshot(
              undefined, // id
              snapshotId, // snapshotId
              snapshotData, // snapshotData
              undefined, // categoryProperties
              (snapshotStore) => {
                return callback(snapshotStore);
              },
              undefined, // dataStore
              undefined, // dataStoreMethods
              undefined, // metadata
              '', // subscriberId
              '', // endpointCategory
              undefined, // storeProps
              undefined, // snapshotConfigData
              undefined, // subscription
              undefined, // category
              snapshotConfig, // snapshotStoreConfigData
              undefined // snapshotContainer
            );
            
            snapshot = updatedSnapshot;
          }

          // Optionally check for and call other methods
          if (isDataStoreMethod<T, K, 'addStore', ExcludedFields>(snapshotStoreMethods.addStore)) {
            // Can use addStore method if needed
          }
          
          if (isDataStoreMethod<T, K, 'getStore', ExcludedFields>(snapshotStoreMethods.getStore)) {
            // Can use getStore method if needed
          }
        } else {
          throw new Error("Provided snapshotMethods is not a valid SnapshotStoreMethods object or function array");
        }
      }

      resolve(snapshot);
    } catch (error) {
      console.error("Error processing snapshot methods:", error);
      reject(error);
    }
  });
}


