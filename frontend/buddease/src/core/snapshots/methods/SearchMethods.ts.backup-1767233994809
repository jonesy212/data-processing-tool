// SearchMethods.ts
import type { BaseDataEntity, DefaultExcludedFields, DefaultMeta } from '@/core/config/BaseConfig';
import { Attachment } from '@/core/documents/attachment/Attachment';
import { Category } from '@/core/libraries/categories/generateCategoryProperties';
import type { Snapshot } from '@/core/snapshots/Snapshot';
import SnapshotStore from "@/core/snapshots/SnapshotStore";

export const SearchMethods = {
  searchSnapshots: function <
    T extends BaseDataEntity,
    K extends T = T,
    Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
    AttachmentType extends Attachment = Attachment,
    ExcludedFields extends keyof T = DefaultExcludedFields<T>,
    IncludedFields extends keyof T = keyof T
  >(
    this: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
    query: string,
    fields?: (keyof Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>)[]
  ): Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[] {
    return this.executeDelegateMethod?.('searchSnapshots', query, fields) || [];
  },

  searchSnapshotsByCriteria: function <
    T extends BaseDataEntity,
    K extends T = T,
    Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
    AttachmentType extends Attachment = Attachment,
    ExcludedFields extends keyof T = DefaultExcludedFields<T>,
    IncludedFields extends keyof T = keyof T
  >(
    this: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
    criteria: Partial<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>>
  ): Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[] {
    return this.executeDelegateMethod?.('searchSnapshotsByCriteria', criteria) || [];
  },

  searchSnapshotsByText: function <
    T extends BaseDataEntity,
    K extends T = T,
    Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
    AttachmentType extends Attachment = Attachment,
    ExcludedFields extends keyof T = DefaultExcludedFields<T>,
    IncludedFields extends keyof T = keyof T
  >(
    this: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
    text: string
  ): Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[] {
    return this.executeDelegateMethod?.('searchSnapshotsByText', text) || [];
  },

  advancedSearch: function <
    T extends BaseDataEntity,
    K extends T = T,
    Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
    AttachmentType extends Attachment = Attachment,
    ExcludedFields extends keyof T = DefaultExcludedFields<T>,
    IncludedFields extends keyof T = keyof T
  >(
    this: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
    searchCriteria: {
      query?: string;
      categories?: Category[];
      dateRange?: { start: Date; end: Date };
      statuses?: string[];
      tags?: string[];
    }
  ): Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[] {
    return this.executeDelegateMethod?.('advancedSearch', searchCriteria) || [];
  },

  searchAndFilter: function <
    T extends BaseDataEntity,
    K extends T = T,
    Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
    AttachmentType extends Attachment = Attachment,
    ExcludedFields extends keyof T = DefaultExcludedFields<T>,
    IncludedFields extends keyof T = keyof T
  >(
    this: SnapshotStore<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>,
    searchTerm: string,
    filters: Partial<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>>
  ): Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>[] {
    return this.executeDelegateMethod?.('searchAndFilter', searchTerm, filters) || [];
  }
};