 * @returns {Promise<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>>} - Promise resolving to the latest snapshot
 */
const getLatestSnapshot = <
  T extends BaseDataEntity,
  K extends T = T,
  Meta extends DefaultMeta<T, K> = DefaultMeta<T, K>,
  AttachmentType extends Attachment = Attachment,
  ExcludedFields extends keyof T = DefaultExcludedFields<T>,
  IncludedFields extends keyof T = keyof T
>(
  snapshotProvider?: (id: string) => Promise<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>>
): Promise<Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>> => {
  return new Promise((resolve, reject) => {
    if (!snapshotProvider) {
      reject(new Error('Snapshot provider function is required'));
      return;
    }

    const latestId = 'latest_' + Date.now();

    snapshotProvider(latestId)
      .then(snapshot => {
        if (!snapshot) {
          throw new Error('Failed to retrieve latest snapshot');
        }
        resolve(snapshot);
      })
      .catch(error => {
        console.error('Error fetching latest snapshot:', error);
        reject(error);
      });
  });
};


