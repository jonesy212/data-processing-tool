// ClientSubscriber.ts
import type { BaseDataEntity, DefaultExcludedFields, DefaultMeta } from '@/core/config/BaseConfig';
import { Attachment } from '@/core/documents/attachment/Attachment';
import type { Snapshot } from '@/core/snapshots/Snapshot';
import { AppBaseParams } from '@/core/typings/entities/AppEntity';
import { ExchangeAttachment, ExchangeEntity, ExchangeExcludedFields, ExchangeIncludedFields, ExchangeK, ExchangeMeta, OrderBookEntity } from '../typings/exchangeTypes';


export class ClientSubscriber<
  T extends BaseDataEntity = AppBaseParams['T'],
  K extends T = T,
  Meta extends DefaultMeta<T, K> = AppBaseParams['Meta'],
  AttachmentType extends Attachment = AppBaseParams['AttachmentType'],
  ExcludedFields extends keyof T = AppBaseParams['ExcludedFields'],
  IncludedFields extends keyof T = AppBaseParams['IncludedFields']
> {
  private callbacks: Map<string, (data: Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>) => void> = new Map();
  public id: string;
  public name: string;

  constructor(id: string, name: string) {
    this.id = id;
    this.name = name;
  }

  subscribe(callback: (data: Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>) => void): string {
    const callbackId = `callback_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
    this.callbacks.set(callbackId, callback);
    return callbackId;
  }

  unsubscribe(callbackId: string): void {
    this.callbacks.delete(callbackId);
  }

  notify(data: Snapshot<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>): void {
    this.callbacks.forEach(callback => {
      try {
        callback(data);
      } catch (error) {
        console.error('Error in subscriber callback:', error);
      }
    });
  }

  // Static creator with ALL 6 parameters and proper defaults
  static createSubscriber<
    T extends BaseDataEntity = AppBaseParams['T'],
    K extends T = T,
    Meta extends DefaultMeta<T, K> = AppBaseParams['Meta'],
    AttachmentType extends Attachment = AppBaseParams['AttachmentType'],
    ExcludedFields extends keyof T = AppBaseParams['ExcludedFields'],
    IncludedFields extends keyof T = AppBaseParams['IncludedFields']
  >(
    id: string, 
    name: string
  ): ClientSubscriber<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields> {
    return new ClientSubscriber<T, K, Meta, AttachmentType, ExcludedFields, IncludedFields>(id, name);
  }

  // App-specific convenience method
  static createAppSubscriber(id: string, name: string): ClientSubscriber<
    AppBaseParams['T'],
    AppBaseParams['K'],
    AppBaseParams['Meta'],
    AppBaseParams['AttachmentType'],
    AppBaseParams['ExcludedFields'],
    AppBaseParams['IncludedFields']
  > {
    return this.createSubscriber<
      AppBaseParams['T'],
      AppBaseParams['K'],
      AppBaseParams['Meta'],
      AppBaseParams['AttachmentType'],
      AppBaseParams['ExcludedFields'],
      AppBaseParams['IncludedFields']
    >(id, name);
  }

  // BaseDataEntity-specific method with ALL 6 parameters
  static createBaseDataSubscriber(id: string, name: string): ClientSubscriber<
    BaseDataEntity,
    BaseDataEntity,
    DefaultMeta<BaseDataEntity, BaseDataEntity>,
    Attachment,
    DefaultExcludedFields<BaseDataEntity>,
    keyof BaseDataEntity
  > {
    return this.createSubscriber<
      BaseDataEntity,
      BaseDataEntity,
      DefaultMeta<BaseDataEntity, BaseDataEntity>,
      Attachment,
      DefaultExcludedFields<BaseDataEntity>,
      keyof BaseDataEntity
    >(id, name);
  }

    // Exchange-specific convenience methods
static createExchangeSubscriber(id: string, name: string): ClientSubscriber<
    OrderBookEntity,
    OrderBookEntity,
    DefaultMeta<OrderBookEntity, OrderBookEntity>,
    Attachment,
    DefaultExcludedFields<OrderBookEntity>,
    keyof OrderBookEntity
    > {
    return this.createSubscriber<
        OrderBookEntity,
        OrderBookEntity,
        DefaultMeta<OrderBookEntity, OrderBookEntity>,
        Attachment,
        DefaultExcludedFields<OrderBookEntity>,
        keyof OrderBookEntity
    >(id, name);
    }

    // Trade-specific subscriber
    static createTradeSubscriber(id: string, name: string): ClientSubscriber<
    ExchangeEntity,
    ExchangeK,
    ExchangeMeta,
    ExchangeAttachment,
    ExchangeExcludedFields,
    ExchangeIncludedFields
    > {
    return this.createSubscriber<
        ExchangeEntity,
        ExchangeK,
        ExchangeMeta,
        ExchangeAttachment,
        ExchangeExcludedFields,
        ExchangeIncludedFields
    >(id, name);
    }
}

// Simplified creator functions
// Main creator - uses App types (most common case)
export const createSubscriber = (name: string = "ExampleSubscriber") => {
  const subscriberId = `sub_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  return ClientSubscriber.createAppSubscriber(subscriberId, name);
};


// For BaseDataEntity with ALL 6 parameters explicitly defined
export const createBaseDataSubscriber = (name: string = "ExampleSubscriber") => {
  const subscriberId = `sub_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
  return ClientSubscriber.createBaseDataSubscriber(subscriberId, name);
};

export default createSubscriber;