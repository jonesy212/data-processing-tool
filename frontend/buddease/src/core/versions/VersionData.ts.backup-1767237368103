export function createLastUpdated<T extends BaseDataEntity = BaseDataEntity>(
  summary?: string,
): LastUpdated<T> {
  const now = new Date();
  return {
    lastUpdated: now,
    timestamp: now,
    updatedBy: "system",
    changeLogSummary: summary || "No changes recorded.",
