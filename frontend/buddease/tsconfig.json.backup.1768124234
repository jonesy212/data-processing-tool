{
  "compilerOptions": {
    "target": "es2018",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext",
      "ES2017",
      "ES2015"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "noEmit": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "module": "esnext",
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "node",
      "react",
      "react-dom",
      "next"
    ],
    "paths": {
      "@/*": [
        "./*",
        "./src/*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@/core/*": [
        "./src/core/*"
      ],
      "@/components/*": [
        "./src/app/components/*",
        "./app/components/*"
      ],
      "@/hooks/*": [
        "./src/app/hooks/*",
        "./app/hooks/*"
      ],
      "@/api/*": [
        "./src/app/api/*",
        "./app/api/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      "@/models/*": [
        "./src/app/models/*",
        "./app/models/*"
      ],
      "@/state/*": [
        "./src/app/state/*",
        "./app/state/*"
      ],
      "@/services/*": [
        "./src/app/services/*",
        "./app/services/*"
      ],
      "@/layout/*": [
        "./src/app/layout/*",
        "./app/layout/*"
      ],
      "@/config/*": [
        "./src/app/config/*",
        "./app/config/*"
      ],
      "@/typings/*": [
        "./src/app/typings/*",
        "./app/typings/*"
      ],
      "@/tokens/*": [
        "./src/app/tokens/*",
        "./app/tokens/*"
      ],
      "@/documents/*": [
        "./src/app/documents/*",
        "./app/documents/*"
      ],
      "@/generators/*": [
        "./src/app/generators/*",
        "./app/generators/*"
      ],
      "@/pages/*": [
        "./src/app/pages/*",
        "./app/pages/*"
      ],
      "@/snapshots/*": [
        "./src/app/snapshots/*",
        "./app/snapshots/*"
      ],
      "@/repositories/*": [
        "./src/app/repositories/*",
        "./app/repositories/*"
      ],
      "@/features/*": [
        "./src/app/features/*",
        "./app/features/*"
      ],
      "@/users/*": [
        "./src/app/users/*",
        "./app/users/*"
      ],
      "@/todos/*": [
        "./src/app/todos/*",
        "./app/todos/*"
      ],
      "@/documentation": [
        "./src/documentation"
      ],
      "@/cli/*": [
        "./src/cli/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types",
      "./src",
      "./src/app/config/declarations",
      "./src/app/types"
    ]
  },
  "ts-node": {
    "require": [
      "tsconfig-paths/register"
    ],
    "esm": false,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".next/types/**/*.ts",
    "src/**/*",
    "platform/**/*",
    ".next/dev/types/**/*.ts",
    "check-imports.mjs",
    "debug-tsx.mjs",
    "debug-esm-imports.mjs",
    "css-loader.mjs",
    "simple-import-scanner.cjs"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.test.*",
    "**/*.spec.*",
    "platform/android/**/*",
    "platform/ios/**/*",
    ".comment-fix-backups",
    ".type-import-backups",
    ".import-fix-backups",
    ".ts-backups"
  ]
}