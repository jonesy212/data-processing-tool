{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node"
  },
  "include": [
    "src/app/scripts/**/*",
    "src/app/generators/**/*"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.test.*",
    "**/*.spec.*",
    "platform/android/**/*",
    "platform/ios/**/*",
    ".comment-fix-backups",
    ".type-import-backups",
    ".import-fix-backups",
    ".ts-backups"
  ]
}