{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/app/snapshots/**/*.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.test.*",
    "**/*.spec.*",
    "platform/android/**/*",
    "platform/ios/**/*",
    ".comment-fix-backups",
    ".type-import-backups",
    ".import-fix-backups",
    ".ts-backups"
  ]
}
